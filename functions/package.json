{
  "name": "pulse-functions",
  "description": "Pulse Cloud Functions — server-authoritative maintainers (Server-Functions-Spec.md).",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions --project pulse-b9d96",
    "logs": "firebase functions:log --project pulse-b9d96"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.1.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "typescript": "~5.7.2"
  }
}
