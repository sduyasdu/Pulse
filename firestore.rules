rules_version = '2';

// Multi-tenant isolation model — see plan doc / README for the full data
// model. The load-bearing invariant: nothing under pulses/{pulseId}/** is
// readable or writable without a pulses/{pulseId}/pulseMembers/{uid} doc for
// the requesting user, and pulseMembers docs are ONLY ever created either by
// the Pulse's own creator (as 'owner') or by a user accepting an invite
// addressed to their own verified auth email (role must match the invite).
//
// "List everything I have access to" (dashboard: my Pulses; bootstrap: my
// pending invites) is deliberately NOT implemented with collection-group
// queries. The local Firestore emulator (tested against v1.21.0) rejects
// any collection-group `list` request outright — "No matching allow
// statements" — the instant its rule references `request.auth` in any form,
// even a bare `request.auth != null`, regardless of how narrowly the query
// itself is filtered. Plain (single, concrete-parent) list queries are
// unaffected. So instead of collectionGroup('pulseMembers')/('invites')
// queries, each user gets a denormalized index they list directly:
//   - users/{uid}/myPulses/{pulseId}   — written when membership is granted
//   - inviteIndex/{emailId}/pending/{pulseId} — written when someone is
//     invited by email, before they may even have an account yet
// Both are pure convenience indexes, not security boundaries: every actual
// read/write of Pulse data is still independently re-checked against the
// real pulseMembers doc below, so a corrupted index entry can only make a
// user's own dashboard show a broken card, never grant real access.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return ('email' in request.auth.token) ? request.auth.token.email.lower() : '';
    }

    // ---- quotas (Plans-Spec §5, PL5 option b) ----
    // Counters SF11 owns and clients may never write. Named once so the
    // workspace create/update rules and any future counter stay in step.
    function SERVER_COUNTERS() { return ['pulseCount']; }

    // The org's plan, defaulting to Starter when no billing doc exists — the
    // free tier IS the absence of a subscription (Plans-Spec §4). `past_due`
    // deliberately keeps its paid tier here: the client-side grace window
    // (DELINQUENCY_GRACE_DAYS) can't be expressed in rules, and the generous
    // reading is the correct one for a quota — a failed card is usually an
    // expired card, not a decision to stop paying. SF3 emits
    // `customer.subscription.deleted` when dunning is exhausted, and that is
    // what drops the tier for real.
    function planTierOf(orgId) {
      return !exists(/databases/$(database)/documents/billing/$(orgId))
        ? 'starter'
        : (get(/databases/$(database)/documents/billing/$(orgId)).data.get('status', 'canceled') in ['active', 'trialing', 'past_due']
            ? get(/databases/$(database)/documents/billing/$(orgId)).data.get('tier', 'starter')
            : 'starter');
    }

    // Mirrors TIER_ENTITLEMENTS.maxPulses in src/domain/entitlements.ts — keep
    // the two in step. -1 stands for "unlimited" (rules have no null-safe max).
    function maxPulsesFor(orgId) {
      let tier = planTierOf(orgId);
      return tier == 'business' ? -1 : (tier == 'pro' ? 5 : 3);
    }

    // Room for one more Pulse in this org?
    //
    // `pulseCount` is absent until SF11 first writes it, so it defaults to 0 —
    // meaning an org that predates SF11 gets one free create before the counter
    // materializes and the cap starts biting. That is the same transient
    // over-allow PL5 already accepts for the async counter, and it self-heals:
    // SF11 recounts on every create. Run the backfill script to close it
    // immediately (functions/scripts/backfill-pulse-counts.mjs).
    function withinPulseQuota(orgId) {
      let limit = maxPulsesFor(orgId);
      return limit < 0 ||
        !exists(/databases/$(database)/documents/workspaces/$(orgId)) ||
        get(/databases/$(database)/documents/workspaces/$(orgId)).data.get('pulseCount', 0) < limit;
    }

    // ---- workspaces ----
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workspaceMembers/$(request.auth.uid));
    }
    function workspaceRole(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/workspaceMembers/$(request.auth.uid)).data.role;
    }

    // ---- pulses ----
    function isPulseMember(pulseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/pulses/$(pulseId)/pulseMembers/$(request.auth.uid));
    }
    function pulseRole(pulseId) {
      return get(/databases/$(database)/documents/pulses/$(pulseId)/pulseMembers/$(request.auth.uid)).data.role;
    }
    function canEditPulse(pulseId) {
      return isPulseMember(pulseId) && pulseRole(pulseId) in ['owner', 'editor'];
    }
    function isPulseOwner(pulseId) {
      return isPulseMember(pulseId) && pulseRole(pulseId) == 'owner';
    }
    // Is this Pulse un-archived (i.e. writable)? An archived Pulse is read-only
    // for EVERY member, owners included, until an owner unarchives
    // (Hide-and-Archive-Spec §4). There is no single chokepoint to hang this on:
    // epics/resources go through canEditPulse, features/costs through
    // callerEditScope, comments through isPulseMember — so each write gate ANDs
    // this in for itself. Cost is one extra document read (the pulse doc) on
    // subcollection writes; inside match /pulses/{pulseId} use resource.data
    // directly instead, which is free.
    function isPulseActive(pulseId) {
      return get(/databases/$(database)/documents/pulses/$(pulseId)).data.get('archivedAt', null) == null;
    }
    // May the caller write content right now? The archive-aware replacement for
    // canEditPulse at every content call-site.
    function canWriteContent(pulseId) {
      return canEditPulse(pulseId) && isPulseActive(pulseId);
    }
    // Deletes survive the freeze for OWNERS ONLY, because deletePulse() is a
    // client-side cascade: it removes every subcollection doc before the pulse
    // doc, so freezing deletes would make an archived Pulse undeletable — and
    // deleting an archived Pulse is the intended way to reclaim a plan slot
    // (Plans-Spec §5.1, PL12). This grants nothing new: an owner can already
    // delete the whole Pulse. Archive stops quiet mutation, not destruction.
    function canDeleteContent(pulseId) {
      return canEditPulse(pulseId) && (isPulseActive(pulseId) || pulseRole(pulseId) == 'owner');
    }
    // Granular edit scope (Permissions-Spec §4): 'all' (owner/editor), 'lead'
    // (Task Lead — only tasks they lead), or 'none'. Derived from the ROLE for
    // the fixed presets (so a link-joiner can't self-set `caps` to escalate);
    // the materialized `caps` are only consulted for a 'custom' role. Callers
    // MUST guard with isPulseMember first (get() on a missing doc fails).
    function callerEditScope(pulseId) {
      let m = get(/databases/$(database)/documents/pulses/$(pulseId)/pulseMembers/$(request.auth.uid)).data;
      return (m.role in ['owner', 'editor']) ? 'all'
        : (m.role == 'taskLead') ? 'lead'
        : (m.role == 'custom' && 'caps' in m) ? m.caps.editScope
        : 'none';
    }
    // Read scope: 'all' (every role except My-Beat Viewer) or 'beat' (only
    // features whose assignedUids include their uid). Role-derived (see above).
    // NOTE: for a `list`, Firestore evaluates the query, so a 'beat' caller MUST
    // query where('assignedUids','array-contains', uid); an unconstrained
    // features list is rejected wholesale (Permissions-Spec §4.3).
    function callerReadScope(pulseId) {
      let m = get(/databases/$(database)/documents/pulses/$(pulseId)/pulseMembers/$(request.auth.uid)).data;
      return (m.role == 'myBeatViewer') ? 'beat'
        : (m.role == 'custom' && 'caps' in m) ? m.caps.readScope
        : 'all';
    }
    // May the caller see people cost — hourly rates and the labour figures derived
    // from them (Costs-Spec §8.7)? Owner by preset; a `custom` role needs the
    // capability explicitly. Deliberately narrower than editResources: an editor may
    // rename people and set their capacity without being trusted with their pay.
    function canViewPeopleCost(pulseId) {
      let m = get(/databases/$(database)/documents/pulses/$(pulseId)/pulseMembers/$(request.auth.uid)).data;
      return m.role == 'owner'
        || (m.role == 'custom' && 'caps' in m && m.caps.get('viewPeopleCost', false) == true);
    }
    // Does the caller lead this task? Used by the costs block, where a Task
    // Lead's write scope is defined by the parent feature rather than by the
    // document being written (Costs-Spec §7). A missing feature reads as
    // "not led", denying the write.
    function leadsFeature(pulseId, featureId) {
      return exists(/databases/$(database)/documents/pulses/$(pulseId)/features/$(featureId))
        && get(/databases/$(database)/documents/pulses/$(pulseId)/features/$(featureId)).data.get('leadUid', null) == request.auth.uid;
    }
    // A copy-link self-join is valid when the Pulse has an active `invite` and
    // the membership doc being written carries a joinToken + role matching it.
    // The token is an unguessable capability only reachable via the shared link.
    function joinLinkOk(pulseId, data) {
      let invite = get(/databases/$(database)/documents/pulses/$(pulseId)).data.get('invite', null);
      return invite != null &&
        'joinToken' in data && data.joinToken == invite.token &&
        data.role == invite.role;
    }

    // ---- users ----
    match /users/{uid} {
      allow read, create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      // Dashboard index: "every Pulse I can access." Purely self-owned —
      // see the file-level comment on why this isn't a collection-group
      // query, and why a permissive self-write rule here is still safe.
      match /myPulses/{pulseId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---- workspaces ----
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      // The creator becomes the sole owner in the same client-side bootstrap
      // transaction that also writes their workspaceMembers/{uid} doc below.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid
        // A workspace can't be born with a forged counter either.
        && !request.resource.data.keys().hasAny(SERVER_COUNTERS());
      // `pulseCount` is SF11's (functions/src/counters.ts). An owner who could
      // write it could write 0 and the quota gate below would be decoration, so
      // it is excluded here; the Admin SDK bypasses rules, which is how SF11
      // still maintains it.
      allow update: if isWorkspaceMember(workspaceId) && workspaceRole(workspaceId) == 'owner'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(SERVER_COUNTERS());
      allow delete: if false; // not supported in v1

      match /workspaceMembers/{memberUid} {
        allow read: if isSignedIn() && (memberUid == request.auth.uid || isWorkspaceMember(workspaceId));
        allow create: if isSignedIn() && memberUid == request.auth.uid
          && request.resource.data.role == 'owner'
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
        allow update, delete: if isWorkspaceMember(workspaceId) && workspaceRole(workspaceId) == 'owner';
      }
    }

    // ---- billing / plan (Plans-Spec §4) — server-authoritative ----
    // orgId === workspaceId (PL6). Read by org admins (workspace owners) for the
    // billing UI; NEVER client-writable — the tier is set only by the Stripe
    // webhook (SF3) via the Admin SDK, which bypasses these rules. Feature-gating
    // rules will get() this doc (get() bypasses the read rule).
    //
    // NOTE: no entitlement *enforcement* gates ship here yet. Enforcing
    // "absent doc ⇒ Free" today would revoke already-shipped features (scoped
    // roles) for everyone, since no billing doc exists. Gating lands with real
    // billing data + frozen PL2 (Billing-and-Backend-Build-Plan Phase 3).
    match /billing/{orgId} {
      allow read: if isWorkspaceMember(orgId) && workspaceRole(orgId) == 'owner';
      allow write: if false;
    }

    // ---- invite discovery index (pre-membership, keyed by email) ----
    match /inviteIndex/{emailId} {
      match /pending/{pulseId} {
        allow read, delete: if isSignedIn() && emailId == myEmail();
        allow create: if canEditPulse(pulseId);
        allow update: if false;
      }
    }

    // ---- pulses ----
    match /pulses/{pulseId} {
      allow read: if isPulseMember(pulseId);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid
        // Never born archived — so duplicating an archived Pulse yields an
        // active copy (Hide-and-Archive-Spec §4.3).
        && request.resource.data.get('archivedAt', null) == null
        // Plan quota (Plans-Spec §3.2/§5). Only creates are gated: this is the
        // one write that can raise the count. Deleting a Pulse is how you
        // reclaim a slot, so it must stay ungated — gating it would make an
        // over-quota org unable to get back under its cap (CLAUDE.md: any new
        // write gate must be checked against the deletePulse cascade).
        // Must be an org you actually belong to. Without this the quota is
        // trivially dodged by pointing workspaceId at a made-up id (no doc, no
        // counter, no limit) or at someone else's org (spending their quota).
        && isWorkspaceMember(request.resource.data.workspaceId)
        && withinPulseQuota(request.resource.data.workspaceId);
      allow update: if
        // (a) The archive / unarchive write itself — owner-only, and the ONLY
        // write permitted to cross the freeze. hasOnly() stops a rename or a
        // config change riding along; the ternary pins archivedBy to the caller
        // when archiving and to null when clearing, so the banner can't be
        // forged or left stale (Hide-and-Archive-Spec §4.3).
        (isPulseOwner(pulseId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['archivedAt', 'archivedBy', 'updatedAt'])
          && (request.resource.data.get('archivedAt', null) == null
                ? request.resource.data.get('archivedBy', null) == null
                : request.resource.data.get('archivedBy', null) == request.auth.uid))
        ||
        // (b) Every other update: frozen while archived, and the archive fields
        // are pinned so this path can never set them. An invite link may only
        // ever grant viewer/editor — never owner — so an editor can't mint an
        // owner-granting link (owner promotion stays owner-only via
        // setMemberRole).
        (canEditPulse(pulseId)
          && resource.data.get('archivedAt', null) == null
          && request.resource.data.get('archivedAt', null) == resource.data.get('archivedAt', null)
          && request.resource.data.get('archivedBy', null) == resource.data.get('archivedBy', null)
          && (request.resource.data.get('invite', null) == null
              || request.resource.data.invite.role in ['viewer', 'editor', 'taskLead', 'myBeatViewer']));
      // Unchanged: archive is not a delete guard (Hide-and-Archive-Spec §2.4).
      allow delete: if isPulseOwner(pulseId);

      match /pulseMembers/{memberUid} {
        allow read: if isSignedIn() && (memberUid == request.auth.uid || isPulseMember(pulseId));
        allow create: if isSignedIn() && memberUid == request.auth.uid && (
          // Case 1: Pulse creator grants themselves 'owner' right after
          // creating the Pulse doc.
          (request.resource.data.role == 'owner' &&
            get(/databases/$(database)/documents/pulses/$(pulseId)).data.createdBy == request.auth.uid)
          ||
          // Case 2 (legacy, being retired): invited user accepts an invite
          // addressed to their own verified email; role must match the invite's.
          (myEmail() != '' &&
            exists(/databases/$(database)/documents/pulses/$(pulseId)/invites/$(myEmail())) &&
            get(/databases/$(database)/documents/pulses/$(pulseId)/invites/$(myEmail())).data.role == request.resource.data.role)
          ||
          // Case 3: joining via a valid copy-link (token + role match the
          // Pulse's active `invite`). Not while archived: a link circulating
          // before the freeze would otherwise keep growing the roster of a
          // finished project, silently and unactionably — and it can't be
          // rotated or revoked while the pulse doc is frozen, so inert is the
          // only coherent state (Hide-and-Archive-Spec §4.6, HA3).
          (joinLinkOk(pulseId, request.resource.data) && isPulseActive(pulseId))
        );
        // The owner may change anything; a member may update their OWN doc but
        // only fields that don't affect access — uid/role/email/joinedAt are
        // pinned, so this effectively allows only the denormalized photoURL.
        allow update: if isPulseOwner(pulseId)
          || (memberUid == request.auth.uid
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.role == resource.data.role
              && request.resource.data.email == resource.data.email
              && request.resource.data.joinedAt == resource.data.joinedAt
              // Can't self-escalate: only the owner may change caps.
              && request.resource.data.get('caps', null) == resource.data.get('caps', null));
        // The owner may remove anyone; anyone may remove THEMSELVES (leave) —
        // EXCEPT an owner, who may never self-delete. A Pulse must always keep
        // at least one owner, because archive/unarchive/delete/promote all
        // require one and an ownerless *archived* Pulse would be frozen,
        // undeletable and still holding a plan slot forever
        // (Hide-and-Archive-Spec §5.7, HA10). An owner's exits are archive,
        // delete, or transfer-then-leave (self-demote via the update rule above,
        // or have a co-owner remove them).
        //
        // This is deliberately STRICTER than "the last owner may not leave":
        // rules can't count a collection, so "does another owner exist?" isn't
        // expressible without a denormalized counter. The client enforces the
        // exact rule off the live roster (CollaboratorsDialog); this backstop
        // fails safe, and holds against a concurrent double-leave that the
        // client-side count cannot see.
        // NOTE the `memberUid != request.auth.uid` on the owner clause: without
        // it, "an owner may remove anyone" silently re-permits an owner removing
        // THEMSELVES, and the invariant is worth nothing.
        //
        // The third clause is the TEAR-DOWN carve-out. deletePulse() is a
        // client-side cascade that removes the pulse doc and then every
        // pulseMembers doc, the caller's own included — so without this, an
        // owner could no longer finish deleting their own Pulse. Once the pulse
        // doc is gone the roster is orphaned bookkeeping and there is no owner
        // left to protect, so this can't be used to strand anything: while the
        // Pulse still exists, an owner's self-delete is denied.
        allow delete: if (isPulseOwner(pulseId) && memberUid != request.auth.uid)
          || (memberUid == request.auth.uid && pulseRole(pulseId) != 'owner')
          || (memberUid == request.auth.uid
              && !exists(/databases/$(database)/documents/pulses/$(pulseId)));
      }

      match /invites/{emailId} {
        // Individual get()-by-known-path only — see file-level comment for
        // why discovery goes through /inviteIndex instead of a list/query
        // here. Owner/editor can look up a specific invite; the invited
        // user can read their own directly once they know the pulseId
        // (which they will, via /inviteIndex).
        allow get: if canEditPulse(pulseId) || (isSignedIn() && resource.data.email == myEmail());
        // Owner/editor can enumerate this Pulse's outstanding invites to show a
        // "pending invitations" list. Still no collection-group list — this is a
        // plain list under a concrete pulseId (see file-level comment).
        allow list: if canEditPulse(pulseId);
        allow create: if canEditPulse(pulseId) && request.resource.data.email == emailId;
        allow update: if false;
        // Owner/editor can revoke; an invited user can also clear their own
        // invite doc once they've accepted it (emailId is their own email).
        allow delete: if canEditPulse(pulseId) || (isSignedIn() && myEmail() == emailId);
      }

      // In-Pulse notifications: a member creates one addressed to another
      // member; only the target reads/updates/deletes their own.
      match /notifications/{notifId} {
        allow read: if isSignedIn() && resource.data.targetUid == request.auth.uid;
        allow create: if isPulseMember(pulseId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.targetUid != request.auth.uid
          && exists(/databases/$(database)/documents/pulses/$(pulseId)/pulseMembers/$(request.resource.data.targetUid));
        allow update: if isSignedIn() && resource.data.targetUid == request.auth.uid
          && request.resource.data.targetUid == resource.data.targetUid;
        allow delete: if isSignedIn() && resource.data.targetUid == request.auth.uid;
      }

      // Live presence: each member writes only their own heartbeat; all members
      // read to see who's viewing. Stale entries are filtered client-side.
      match /presence/{presenceUid} {
        allow read: if isPulseMember(pulseId);
        allow write: if isSignedIn() && presenceUid == request.auth.uid && isPulseMember(pulseId);
      }

      match /epics/{epicId} {
        allow read: if isPulseMember(pulseId);
        allow create, update: if canWriteContent(pulseId);
        allow delete: if canDeleteContent(pulseId);
      }

      match /features/{featureId} {
        // Full readers see everything; a My-Beat Viewer sees only features their
        // linked uid is assigned to (their client must issue the array-contains
        // query — Permissions-Spec §4.3).
        allow read: if isPulseMember(pulseId) && (
          callerReadScope(pulseId) == 'all'
          || (callerReadScope(pulseId) == 'beat' && request.auth.uid in resource.data.get('assignedUids', []))
        );
        // Create/delete stay editor-scope. Update is allowed for editors, and
        // for a Task Lead only on a task they currently lead — and they can't
        // hand the lead off to escape scope (leadUid pinned). (Permissions-Spec §4.4)
        // Archived freezes create/update for everyone; delete keeps the owner
        // exemption so the cascade in deletePulse() still works (§4.4).
        allow create: if isPulseMember(pulseId) && callerEditScope(pulseId) == 'all'
          && isPulseActive(pulseId);
        allow delete: if isPulseMember(pulseId) && callerEditScope(pulseId) == 'all'
          && (isPulseActive(pulseId) || pulseRole(pulseId) == 'owner');
        allow update: if isPulseMember(pulseId) && isPulseActive(pulseId) && (
          callerEditScope(pulseId) == 'all'
          || (callerEditScope(pulseId) == 'lead'
              && resource.data.get('leadUid', null) == request.auth.uid
              && request.resource.data.get('leadUid', null) == resource.data.get('leadUid', null))
        );
      }

      // Comments (task-level via targetId, Pulse-level when targetId is null,
      // replies via parentId). Any member (viewers included) may comment;
      // authors edit their own; the owner or the author may delete.
      // Comments freeze with everything else while archived (HA2): "read-only
      // for all members" has to be true without a footnote, and a thread nobody
      // can act on is a worse affordance than a clean freeze. Existing comments
      // stay readable; discussion resumes on unarchive.
      match /comments/{commentId} {
        allow read: if isPulseMember(pulseId);
        allow create: if isPulseMember(pulseId) && request.resource.data.authorUid == request.auth.uid
          && isPulseActive(pulseId);
        allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && isPulseActive(pulseId);
        allow delete: if (isPulseOwner(pulseId))
          || (isSignedIn() && resource.data.authorUid == request.auth.uid && isPulseActive(pulseId));
      }

      match /resources/{resourceId} {
        allow read: if isPulseMember(pulseId);
        allow create, update: if canWriteContent(pulseId);
        allow delete: if canDeleteContent(pulseId);
      }

      // Hourly rates (Costs-Spec §8.3) — the one genuinely sensitive collection in
      // a Pulse. Admin-only, read AND write: a member who can't read a rate can't
      // derive labour cost either, so people costing fails closed by construction
      // rather than by the UI remembering to hide something.
      // NOTE: read and write are split (they were one `read, write` rule) so the
      // archive freeze can apply to writes ONLY — cost reporting on a finished
      // project is a reason to keep it, so freezing the read would break the
      // thing archiving is for (Hide-and-Archive-Spec §4.1).
      match /rates/{resourceId} {
        allow read: if isPulseMember(pulseId) && canViewPeopleCost(pulseId);
        allow create, update: if isPulseMember(pulseId) && canViewPeopleCost(pulseId)
          && isPulseActive(pulseId);
        allow delete: if isPulseMember(pulseId) && canViewPeopleCost(pulseId)
          && (isPulseActive(pulseId) || pulseRole(pulseId) == 'owner');
      }

      // Costs (Costs-Spec.md §7). A cost has no capability of its own — it
      // inherits the gates of the task it hangs off: reads follow the feature
      // read scope via the `scopeUids` denorm, writes follow editScope, so a
      // Task Lead can log spend on a task they lead. As with features, a
      // 'beat' caller MUST issue the array-contains query on `scopeUids`.
      match /costs/{costId} {
        allow read: if isPulseMember(pulseId) && (
          callerReadScope(pulseId) == 'all'
          || (callerReadScope(pulseId) == 'beat' && request.auth.uid in resource.data.get('scopeUids', []))
        );
        // featureId is required (CO5) and pinned on update, so a Task Lead
        // can't re-parent a cost onto a task outside their scope.
        allow create: if isPulseMember(pulseId)
          && request.resource.data.featureId is string
          && isPulseActive(pulseId)
          && (callerEditScope(pulseId) == 'all'
              || (callerEditScope(pulseId) == 'lead' && leadsFeature(pulseId, request.resource.data.featureId)));
        allow update: if isPulseMember(pulseId)
          && request.resource.data.featureId == resource.data.featureId
          && isPulseActive(pulseId)
          && (callerEditScope(pulseId) == 'all'
              || (callerEditScope(pulseId) == 'lead' && leadsFeature(pulseId, resource.data.featureId)));
        // Owner exemption on delete only — see canDeleteContent().
        allow delete: if isPulseMember(pulseId)
          && (isPulseActive(pulseId) || pulseRole(pulseId) == 'owner')
          && (callerEditScope(pulseId) == 'all'
              || (callerEditScope(pulseId) == 'lead' && leadsFeature(pulseId, resource.data.featureId)));
      }

      // Activity log (Changelog-Spec.md) — append-only. Any member may create an
      // entry about their OWN action (v1 client-emitted; `actorUid` pinned to the
      // writer). Entries are immutable. Reads follow the caps model: full readers
      // see all; a My-Beat Viewer sees only entries whose `scopeUids` include them
      // (feature entries in their beat), and must query array-contains (§4.3).
      match /activity/{entryId} {
        allow read: if isPulseMember(pulseId) && (
          callerReadScope(pulseId) == 'all'
          || (callerReadScope(pulseId) == 'beat' && request.auth.uid in resource.data.get('scopeUids', []))
        );
        allow create: if isPulseMember(pulseId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.source == 'client';
        allow update, delete: if false;
      }
    }
  }
}
