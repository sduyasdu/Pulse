# Copy this file to .env.local (gitignored) and fill in your Firebase
# project's web app config (Firebase console → Project settings → General →
# Your apps → SDK setup and configuration → Config).
VITE_FIREBASE_API_KEY=
# The origin that serves Firebase Auth's hidden iframe and its sign-in handler,
# so it is visible to users (in the status bar on load, and in the Google
# sign-in popup). Firebase's default is <project>.firebaseapp.com; any domain
# attached to Hosting serves /__/auth/ too, so a branded one can be used
# instead — but the OAuth client's authorised redirect URIs must then include
# https://<that-domain>/__/auth/handler, or Google sign-in fails with
# redirect_uri_mismatch.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the app at local Firebase emulators instead of the
# live project (run `npm run emulators` first).
VITE_USE_FIREBASE_EMULATORS=false
